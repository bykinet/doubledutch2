rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // 1. users/{uid}
    // Users can read their own profile, or admins can search users
    // Clients can only update their nickname
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'lastLoginAt']);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // 2. privateProfiles/{uid}
    // Strictly forbidden for client read and write. Cloud Functions only.
    match /privateProfiles/{uid} {
      allow read, write: if false;
    }

    // 3. sessions/{sessionId}
    // Public read for leaderboard ranking comparison
    // Create allowed for own uid (or guest null uid)
    // Updates prohibited from client; finalized by cloud function
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.uid == null);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 4. auditLogs/{logId}
    // Strictly read/write by admin or Cloud Functions
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
